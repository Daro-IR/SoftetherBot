# ============================================================================
# .env — Configuración de SoftetherBot
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el .env real a un repositorio público (contiene secretos).
# ============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# IDs de Telegram (numéricos) autorizados como administrador, separados por coma
ADMIN_TELEGRAM_IDS=

# --- SoftEther (API JSON-RPC de gestión) ---
# El bot llama SIEMPRE por localhost porque corre en el mismo VPS que SoftEther.
SOFTETHER_JSONRPC_URL=https://127.0.0.1:5555/api/
SOFTETHER_ADMIN_PASSWORD=
SOFTETHER_HUB_NAME=BFP2_LAN
SOFTETHER_HUB_PASSWORD=

# --- Datos de pago que el bot le muestra al cliente ---
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_PHONE_NUMBER=
PAYMENT_INSTRUCTIONS=Transferir el monto acordado y enviar captura del comprobante

# --- Contrato ---
CONTRACT_DURATION_DAYS=31
CONTRACT_WARNING_DAYS_BEFORE=4

# --- Base de datos ---
DATABASE_PATH=./bot/db/softetherbot.sqlite3

# --- Insurgency Server ---
INSURGENCY_DIR=/opt/insurgency-server
INSURGENCY_MAX_PLAYERS=12
INSURGENCY_PORT=27015

# --- Setup ---
# Se marca automáticamente como "true" tras completar el Setup Wizard
SETUP_COMPLETED=false

# --- RCON / Game Server Hub ---
# Contraseña inicial común. Cada servidor guarda su propia copia cifrada y puede cambiarse individualmente.
# Si queda vacía, SoftetherBot genera una al instalar el primer servidor.
RCON_DEFAULT_PASSWORD=
GAME_RESERVE_RAM_MB=700
GAME_RESERVE_DISK_MB=2048

# --- Game Server Hub / Mini App ---
STEAMCMD_DIR=/opt/steamcmd
GAME_SERVERS_ROOT=/opt/softetherbot/game-servers
MINIAPP_PORT=8090
MINIAPP_PUBLIC_URL=https://TU-DOMINIO/juegos
# Clave maestra para cifrar RCON y otros secretos (genera una de 32+ caracteres)
SOFTETHERBOT_MASTER_KEY=

BACKUP_TELEGRAM=true
BACKUP_INTERVAL_HOURS=24
